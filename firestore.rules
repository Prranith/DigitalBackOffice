rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Users collection: PII isolation, users can only read and write their own doc
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;
      allow create: if isOwner(userId) && isValidId(userId)
        && incoming().id == userId
        && incoming().email is string && incoming().email.size() <= 256
        && incoming().createdAt == request.time;
      allow update: if isOwner(userId) && isValidId(userId)
        && incoming().id == existing().id
        && incoming().email == existing().email
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
      allow delete: if isOwner(userId) && isValidId(userId);
    }

    // Analyses collection
    match /analyses/{analysisId} {
      allow get: if isSignedIn() && isValidId(analysisId) && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(analysisId)
        && incoming().userId == request.auth.uid
        && incoming().id == analysisId
        && incoming().title is string && incoming().title.size() <= 256
        && incoming().createdAt == request.time;
      allow update: if isSignedIn() && isValidId(analysisId)
        && existing().userId == request.auth.uid
        && incoming().userId == existing().userId
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
      allow delete: if isSignedIn() && isValidId(analysisId) && existing().userId == request.auth.uid;
    }

    // Dashboards collection
    match /dashboards/{dashboardId} {
      allow get: if isSignedIn() && isValidId(dashboardId) && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(dashboardId)
        && incoming().userId == request.auth.uid
        && incoming().id == dashboardId
        && incoming().title is string && incoming().title.size() <= 256
        && incoming().createdAt == request.time;
      allow update: if isSignedIn() && isValidId(dashboardId)
        && existing().userId == request.auth.uid
        && incoming().userId == existing().userId
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
      allow delete: if isSignedIn() && isValidId(dashboardId) && existing().userId == request.auth.uid;
    }
  }
}
